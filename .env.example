# --- Server ---
SERVER_PORT=8080
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DB=kmovie
POSTGRES_USER=kmovie
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
JPA_DDL_AUTO=update

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=random-string-at-least-32-bytes
JWT_EXPIRATION_DAYS=7
JWT_STAY_LOGGED_IN_EXPIRATION_DAYS=90
JWT_ISSUER=kmovie

# --- AWS S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=kmovie-media
AWS_S3_ENDPOINT=
AWS_S3_PATH_STYLE_ACCESS=false

# --- Email (consumed by the external message-dispatch worker) ---
MAIL_FROM=no-reply@kmovie.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- SMS (consumed by the external message-dispatch worker) ---
SMS_PROVIDER=africastalking
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=15

# --- CORS ---
CORS_ALLOWED_ORIGINS=*
